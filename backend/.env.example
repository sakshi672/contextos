# The local setup command creates backend/.env with a generated password.
# Hosted deployments set CONTEXT_OS_DATABASE_URL through their secret store.
CONTEXT_OS_DB_PASSWORD=replace-with-a-local-password
CONTEXT_OS_DATABASE_URL=postgresql://contextos:replace-with-a-local-password@127.0.0.1:5432/contextos
# Optional. Keep unset until you are ready to test cloud AI; then restart API and worker.
# CONTEXT_OS_OPENAI_API_KEY=your-key-in-this-ignored-local-file
