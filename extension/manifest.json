{
  "manifest_version": 3,
  "name": "Context OS",
  "version": "0.1.0",
  "description": "Save the current tab to your private Context OS library.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "action": { "default_title": "Save to Context OS", "default_popup": "popup.html" }
}
